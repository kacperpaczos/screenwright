{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ubuntu autoinstall user-data",
  "type": "object",
  "required": ["autoinstall"],
  "properties": {
    "autoinstall": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"const": 1},
        "locale": {"type": "string"},
        "keyboard": {"type": "object"},
        "network": {"type": "object"},
        "storage": {"type": "object"},
        "identity": {"type": "object"},
        "packages": {"type": "array", "items": {"type": "string"}},
        "late-commands": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}