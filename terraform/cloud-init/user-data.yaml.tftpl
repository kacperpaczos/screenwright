#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
users:
  - name: ${guest_user}
    groups: [wheel, sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
package_update: false
# Sieć NAT `default` libvirta jest tylko IPv4, a mirrory Fedory/Flathub/Ubuntu
# publikują AAAA — bez tego dnf/apt/flatpak wiszą na IPv6 do timeoutu.
write_files:
  - path: /etc/sysctl.d/90-screenwright-ipv4-only.conf
    content: |
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
runcmd:
  - sysctl --system
# Resztę (narzędzia sklepów, katalogi) robi Ansible — cloud-init tylko otwiera drzwi.
